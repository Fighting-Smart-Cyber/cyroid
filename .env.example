# .env.example
# Database
DATABASE_URL=postgresql://proving_ground:proving_ground@db:5432/proving_ground

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=proving_ground
MINIO_SECRET_KEY=proving_ground123
MINIO_BUCKET=proving-ground-artifacts

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# App
DEBUG=true

# Data directory for ISO cache, templates, VM storage
# macOS: REQUIRED - Use ~/.proving_ground (must be under /Users for Docker Desktop file sharing)
# Linux: Use /data/proving-ground or any accessible path
#
# macOS example (replace 'yourname' with your username):
# PROVING_GROUND_DATA_DIR=/Users/yourname/.proving_ground
#
# Linux example:
# PROVING_GROUND_DATA_DIR=/data/proving-ground
