# frontend/Dockerfile.prod
# Multi-stage production build for the PROVING GROUND frontend

# BASE_IMAGE/BASE_TAG name the RUNTIME base, because that is the one Iron Bank hardens and the
# one that ships. The builder is a throwaway stage whose output is a directory of static files,
# so it has its own pair. Defaults reproduce the previous build exactly.
ARG BUILDER_IMAGE=docker.io/library/node
ARG BUILDER_TAG=20-alpine
ARG BASE_IMAGE=docker.io/library/nginx
ARG BASE_TAG=alpine

# Stage 1: Build the React application
FROM ${BUILDER_IMAGE}:${BUILDER_TAG} AS builder

WORKDIR /app

# Version passed from CI build

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies (use npm ci if lock file exists, otherwise npm install)
RUN if [ -f package-lock.json ]; then \
      npm ci --ignore-scripts; \
    else \
      npm install --ignore-scripts; \
    fi

# Copy source code
COPY . .

# Build the production bundle
RUN npm run build

# Stage 2: Serve with nginx
FROM ${BASE_IMAGE}:${BASE_TAG}
ARG APP_VERSION=dev

# These were wrong in two ways that Iron Bank would have caught and a licence audit would have
# caught harder: the licence said MIT while the project is AGPL-3.0 (ADR-0008), and the source
# pointed at JongoDB/CYROID, which was archived when MIG-8 moved the engine (ADR-0011).
LABEL org.opencontainers.image.title="cyroid-frontend" \
      org.opencontainers.image.description="CYROID web interface" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.vendor="Fighting Smart Cyber" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.source="https://github.com/Fighting-Smart-Cyber/cyroid"

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf
# The security headers every location has to repeat -- nginx's add_header does not
# accumulate across blocks. See the file itself.
COPY nginx-security-headers.conf /etc/nginx/conf.d/security-headers.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# ASD STIG APSC-DV-000510: the application must execute without excessive account permissions.
# nginx:alpine ships a uid 101 `nginx` user but runs its master as root, which is more privilege than
# serving static files needs. Everything the master writes has to move somewhere this user owns: the
# cache/temp directories (the default client_body/proxy/fastcgi temp paths all live under
# /var/cache/nginx) and the pid file, which nginx.conf now puts in /tmp. The logs need no change -
# the base image already symlinks them to /dev/stdout and /dev/stderr.
RUN chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html
USER nginx

# 8080 because uid 101 cannot bind port 80. Both compose files point Traefik at 8080 to match.
EXPOSE 8080

# Health check (use 127.0.0.1 to avoid IPv6 resolution issues)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
